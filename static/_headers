# Whole /private/ section: noindex (covers the section index + any future tool
# page). The meet-recorder block below adds its page-specific headers on top.
/private/*
  X-Robots-Tag: noindex, nofollow

/private/tools/meet-recorder/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Permissions-Policy: microphone=(self), camera=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'

# Thanks page (issue #43): thin confirmation page, keep it out of the index.
/community/asians-gingers-in-tech/thanks/*
  X-Robots-Tag: noindex, nofollow

# The 404 template (blog-priv#64) is also reachable as an ordinary page:
# Cloudflare serves it at /404.html, which 308-redirects to /404 and answers
# HTTP 200 with the full "Page not found" HTML. Left alone that is an indexable
# soft-200, which is the exact defect blog-priv#64 removed from every dead URL,
# so it would have been relocated to one fixed URL rather than fixed. The 404
# RESPONSES themselves are unaffected: this only tells crawlers not to index the
# page when they reach it by its own address. Asserted by scripts/test_404.py.
/404*
  X-Robots-Tag: noindex, nofollow

# Site JS is served from /js/ unfingerprinted, so a filename never changes when
# its contents do. The page HTML is already `max-age=0, must-revalidate`, but the
# default asset rule gives JS `max-age=14400` — so for up to four hours after a
# deploy a returning member gets FRESH markup against STALE script. hoiboy-uk#57
# made that concrete: the story label promises "minimum 1200 characters" and the
# counter element ships in the HTML, while four-hour-old agit-form.js has neither
# the counter code nor the submit guard. The member types, sees nothing counting,
# hits Send, and collects a server 400 that the page never warned them about.
# max-age=0 does not mean "download every time" — an ETag is already served, so a
# revalidation is a 304 with no body. Applied to /js/* rather than to the one
# file, because every script under it is unfingerprinted and carries the same
# skew. Asserted by scripts/test_404.py.
/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Turnstile (challenges.cloudflare.com) is allowed site-wide in the /* CSP below,
# for the widget on the community "Get featured" form. Cloudflare Pages JOINS
# same-name headers across path rules rather than replacing them, so a per-path
# CSP block cannot ADD a source the root policy lacks: the two policies are sent
# as two CSP headers and the browser enforces their intersection, dropping the
# wider source. The root policy therefore carries challenges.cloudflare.com; it is
# inert on pages with no cf-turnstile widget.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://www.youtube-nocookie.com https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
