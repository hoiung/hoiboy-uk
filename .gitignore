# Environment files
.env
.env.*
!.env.example

# Hugo
public/
resources/
.hugo_build.lock

# Legacy import staging (raw exports, not committed)
legacy/

# Legacy-import per-post logs: leak local absolute FS paths, never publish
# (removed from the repo in #33 — git history retains them; gitignored so the
# import pipeline cannot re-add them)
docs/import-logs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Node (only if any tooling needs it)
# No trailing slash: a directory-only pattern does not match the node_modules
# SYMLINK that scripts/setup-worktree-deps.sh creates in a worktree, so it showed
# as untracked in a public repo whose symlink target is a private absolute path.
node_modules

# Python (import scripts)
__pycache__/
*.pyc
.venv/

# Code review graph (local AST index, regenerable)
.code-review-graph/

# Wrangler local state. Created by `wrangler pages dev` (used to exercise a Pages
# Function against the real Workers runtime) and by the break-glass
# `wrangler pages deploy` in CLAUDE.md, so it appears for anyone following either
# documented procedure. Local cache only, and this repo is PUBLIC, so it must
# never be swept into a commit by an auto-staging hook.
.wrangler/

# Agent working state: git worktrees and scratch files. This repo is PUBLIC and
# nothing under .claude/ is tracked (the last tracked contents were removed at
# a301458 when the AGIT back-office moved to a private repo), but the directory
# was never ignored, so a `git add -A` or an auto-staging pre-commit hook could
# sweep agent scratch into a public commit. Surfaced by the blog-priv#63 Stage 5
# raw-tools audit.
.claude/

# AGIT member-submission PII records + Gmail OAuth credentials are owned by the
# private agit-ops back-office and live at $HOME-external paths (~/.agit-records,
# ~/.agit-secrets). This public repo no longer writes them; these guards remain as
# a belt-and-suspenders so member PII / credentials can never be committed here.
.agit-records/
.agit-secrets/
